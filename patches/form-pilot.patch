+/**
+ * 答案库（本地新增）
+ *
+ * 上游已经有两层记忆：page-memory（按 URL）和 form-store（按字段 signature 跨站）。
+ * 两层都要求**标签基本一模一样**才能命中——signature 是标签文本的哈希。
+ * 校招表单同一个问题各家写法都不同：
+ *
+ *   「是否有销售相关实习经历?」
+ *   「请问您是否有销售相关的实习经历」
+ *   「有无销售实习经历」
+ *
+ * 这三条哈希完全不同，填过一次也不会复用。答案库解决这个：一条记录挂多个
+ * 问法，只要命中任意一个就填。
+ *
+ * 设计取舍（按 我 的要求）：**宁愿冗余也要能命中。**
+ * 问法列表随便加，重复了也无所谓；「是」和「否」的答案分开写成两条更好维护。
+ */
+
+export interface AnswerBankEntry {
+  /** 稳定 id，方便在表格和文档里引用 */
+  id: string;
+  /** 这个问题的各种问法。命中任意一个即可，随便加，冗余没关系 */
+  phrasings: string[];
+  /** 要填进去的内容。radio/select 填**选项上显示的文字**，比如 "是" / "否" */
+  answer: string;
+  /** 只在这些控件类型上生效；省略表示不限 */
+  kinds?: Array<'text' | 'textarea' | 'select' | 'radio' | 'checkbox'>;
+  /** 给人看的说明，引擎不用 */
+  note?: string;
+}
+
+/** 去掉空白和标点，让「是否有销售相关实习经历?」和「是否有销售相关实习经历」等价 */
+export function normalizeLabel(s: string): string {
+  return (s ?? '')
+    .replace(/\s+/g, '')
+    .replace(/[?？:：。.,，、!！（）()【】\[\]"'“”‘’*※・\-—_/]/g, '')
+    .toLowerCase();
+}
+
+/**
+ * 在答案库里找匹配的条目。
+ *
+ * 两轮：先要求问法完整包含在标签里（或反过来），命中最长的那个；
+ * 没有再退化到「标签里出现了问法的全部关键片段」。
+ * 不做编辑距离——校招标签普遍很长，模糊匹配容易乱配，宁可漏也别填错。
+ */
+export function matchAnswer(
+  label: string,
+  bank: AnswerBankEntry[],
+  kind?: string,
+): AnswerBankEntry | null {
+  const norm = normalizeLabel(label);
+  if (!norm) return null;
+
+  let best: AnswerBankEntry | null = null;
+  let bestLen = 0;
+
+  for (const entry of bank) {
+    if (entry.kinds && kind && !entry.kinds.includes(kind as never)) continue;
+    for (const p of entry.phrasings) {
+      const np = normalizeLabel(p);
+      if (!np) continue;
+      // 问法出现在标签里，或标签整个就是问法的一部分。
+      // 反向那半边要求标签本身够长（>=6）：不然 radio 的选项文字「是」
+      // 会命中任何含「是」的问法，等于乱配。
+      const hit = norm.includes(np) || (norm.length >= 6 && np.length > 6 && np.includes(norm));
+      if (!hit) continue;
+      // 命中最长的问法——最长的通常最具体，最不容易配错
+      if (np.length > bestLen) {
+        bestLen = np.length;
+        best = entry;
+      }
+    }
+  }
+  return best;
+}
