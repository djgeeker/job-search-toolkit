+/**
+ * 答案库（本地新增）。重点验两件事：
+ *  1. 换个问法也能命中——这是它存在的理由
+ *  2. 它只在前面几层都没管住时才出手，不会抢走简历已经填对的字段
+ */
+import { describe, it, expect, beforeEach } from 'vitest';
+import { matchAnswer, normalizeLabel, type AnswerBankEntry } from '@/lib/engine/answer-bank';
+import { orchestrateFill } from '@/lib/engine/orchestrator';
+import { createEmptyResume } from '@/lib/storage/types';
+
+const bank: AnswerBankEntry[] = [
+  {
+    id: 'has-sales-intern',
+    phrasings: ['是否有销售相关实习经历', '有无销售实习经历', '是否具备销售实习经验'],
+    answer: '是',
+    kinds: ['radio', 'text'],
+  },
+  {
+    id: 'interview-city',
+    phrasings: ['校招面试站点', '期望面试城市', '面试城市'],
+    answer: '上海',
+    kinds: ['text', 'select'],
+  },
+  {
+    id: 'blank-on-purpose',
+    phrasings: ['是否服从工作地点调配'],
+    answer: '',
+    kinds: ['radio'],
+  },
+];
+
+describe('normalizeLabel', () => {
+  it('抹掉空白和标点', () => {
+    expect(normalizeLabel('是否有销售相关实习经历？')).toBe('是否有销售相关实习经历');
+    expect(normalizeLabel(' 校招面试站点 : ')).toBe('校招面试站点');
+  });
+});
+
+describe('matchAnswer', () => {
+  it('原样的问法命中', () => {
+    expect(matchAnswer('是否有销售相关实习经历', bank)?.id).toBe('has-sales-intern');
+  });
+
+  it('换个说法也命中 —— 这是答案库的意义', () => {
+    expect(matchAnswer('有无销售实习经历？', bank)?.id).toBe('has-sales-intern');
+    expect(matchAnswer('请问您是否具备销售实习经验', bank)?.id).toBe('has-sales-intern');
+  });
+
+  it('标签里带前后缀也能命中', () => {
+    expect(matchAnswer('* 校招面试站点（请选择您大学所在城市）', bank)?.id).toBe('interview-city');
+  });
+
+  it('不相干的标签不命中', () => {
+    expect(matchAnswer('紧急联系人电话', bank)).toBeNull();
+    expect(matchAnswer('', bank)).toBeNull();
+  });
+
+  it('kinds 限定生效', () => {
+    expect(matchAnswer('是否有销售相关实习经历', bank, 'textarea')).toBeNull();
+    expect(matchAnswer('是否有销售相关实习经历', bank, 'radio')?.id).toBe('has-sales-intern');
+  });
+
+  it('多条命中时取问法最长的那个（最具体）', () => {
+    const b: AnswerBankEntry[] = [
+      { id: 'short', phrasings: ['经历'], answer: 'A' },
+      { id: 'long', phrasings: ['是否有销售相关实习经历'], answer: 'B' },
+    ];
+    expect(matchAnswer('是否有销售相关实习经历', b)?.id).toBe('long');
+  });
+});
+
+describe('答案库在填表流程里的位置', () => {
+  beforeEach(() => { document.body.innerHTML = ''; });
+
+  function field(label: string, id: string, tag = 'input') {
+    const d = document.createElement('div');
+    d.innerHTML = `<label for="${id}">${label}</label>` +
+      (tag === 'textarea' ? `<textarea id="${id}" name="${id}"></textarea>`
+                          : `<input id="${id}" name="${id}" type="text">`);
+    document.body.appendChild(d);
+  }
+
+  it('简历管不了的字段，由答案库补上', async () => {
+    field('有无销售实习经历', 'q1');
+    const r = await orchestrateFill(document, createEmptyResume('a', 'a'), null, [], {}, {}, '', {}, bank);
+    expect((document.getElementById('q1') as HTMLInputElement).value).toBe('是');
+    expect(r.items.find((i) => i.label.includes('销售'))?.source).toBe('bank');
+  });
+
+  it('简历已经填对的字段，答案库不抢', async () => {
+    field('姓名', 'name');
+    field('面试城市', 'city');
+    const resume = createEmptyResume('a', 'a');
+    resume.basic.name = '董家豪';
+    const withName: AnswerBankEntry[] = [
+      ...bank,
+      { id: 'hijack', phrasings: ['姓名'], answer: '不该出现的值' },
+    ];
+    await orchestrateFill(document, resume, null, [], {}, {}, '', {}, withName);
+    expect((document.getElementById('name') as HTMLInputElement).value).toBe('董家豪');
+    expect((document.getElementById('city') as HTMLInputElement).value).toBe('上海');
+  });
+
+  it('answer 为空的条目不填，字段保持原样', async () => {
+    field('是否服从工作地点调配', 'q2');
+    await orchestrateFill(document, createEmptyResume('a', 'a'), null, [], {}, {}, '', {}, bank);
+    expect((document.getElementById('q2') as HTMLInputElement).value).toBe('');
+  });
+
+  it('不传答案库时行为不变', async () => {
+    field('有无销售实习经历', 'q3');
+    await orchestrateFill(document, createEmptyResume('a', 'a'), null);
+    expect((document.getElementById('q3') as HTMLInputElement).value).toBe('');
+  });
+});
